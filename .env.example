# MarketPulse configuration.
#
# Every value here is optional. With none of them set the system runs on
# simulated data with in-process state, which is what `npm run dev` does — it
# starts, it shows a live dashboard, and it says clearly that the prices are
# synthetic.

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Without credentials the simulated provider is used and the UI shows a warning
# banner. The provider is inferred from whichever credentials are present, or
# forced with MARKET_DATA_PROVIDER.
MARKET_DATA_PROVIDER=simulated          # simulated | polygon | alpaca

# --- Polygon / Massive -----------------------------------------------------
# Requires a plan that includes stock websocket access. The free tier does not:
# REST aggregates work, but the live trade stream is refused, and this is a
# real-time scanner.
# MARKET_DATA_API_KEY=

# --- Alpaca ----------------------------------------------------------------
# The free "Basic" plan includes a real-time websocket, which makes it the
# cheapest way to run this on live data. Two caveats, both enforced in code:
#   - The IEX feed is one venue carrying roughly 2-3% of consolidated volume,
#     so absolute volume is a sample. Relative comparisons still hold.
#   - Basic caps a subscription at 30 symbols. Narrow the universe rather than
#     letting a sector compute breadth over a truncated constituent set.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# ALPACA_FEED=iex                       # iex (free) | sip (paid, full tape)
# ALPACA_MAX_SYMBOLS=30                 # defaults to 30 on iex, unlimited on sip

# Comma-separated sector ids. Watch fewer sectors properly instead of many
# partially — necessary on plans that cap streamed symbols.
# UNIVERSE_SECTORS=semiconductors,memory

# ---------------------------------------------------------------------------
# Redis — live state and the worker-to-web broadcast channel
# ---------------------------------------------------------------------------
# Required for the real topology: without it the worker and the Next.js app
# cannot see each other's state. Upstash speaks the Redis protocol over rediss://
# REDIS_URL=rediss://default:<password>@<host>:<port>

# ---------------------------------------------------------------------------
# Postgres — durable signals, universe, watchlists, alert rules
# ---------------------------------------------------------------------------
# Without it the universe falls back to the built-in seed and signals are not
# persisted; watchlists and alert rules return 503.
# DATABASE_URL=postgresql://user:password@host:5432/marketpulse

# ---------------------------------------------------------------------------
# Access gate
# ---------------------------------------------------------------------------
# With APP_PASSWORD set, every page and API route requires a session cookie
# obtained from /login. Unset, the gate does not exist and the deployment is
# publicly readable — /api/health reports which, as `authEnabled`.
# APP_PASSWORD=

# Signs the session cookie. Optional: derived from APP_PASSWORD when absent.
# Set it separately to invalidate every session without changing the password.
# AUTH_SECRET=

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
LOG_LEVEL=info                          # debug | info | warn | error

# Subscribe to the NBBO quote feed. Off by default: nothing is computed from
# quotes, and a live open across a few hundred symbols produces tens of
# thousands of messages a second, which saturates the worker and the Redis
# request quota for display detail alone.
# SUBSCRIBE_QUOTES=true
WORKER_MAX_RETRIES=10
WORKER_STALL_TIMEOUT_MS=30000           # No prints for this long in REGULAR = reconnect

# Run the pipeline inside the Next.js process. Defaults to on in development
# when REDIS_URL is unset; never use it in production — deploy the worker
# separately (see README).
# EMBEDDED_WORKER=true

# ---------------------------------------------------------------------------
# Engine tuning
# ---------------------------------------------------------------------------
# Deep-merged over the defaults in shared/config.ts, so weights and thresholds
# can be changed without a redeploy of the engines. Example: make stage 1 less
# sensitive and weight RVOL more heavily.
# MARKETPULSE_CONFIG={"sector":{"stage1":{"minAvgRvol":2.0}},"momentum":{"weights":{"rvol":25}}}

# ---------------------------------------------------------------------------
# Development and demonstration only
# ---------------------------------------------------------------------------
# Pin the market session regardless of the clock, so the system can be
# exercised outside trading hours. Never set in production.
# MARKETPULSE_FORCE_SESSION=REGULAR

# Drive a scripted rally through one sector, for demos and manual QA.
# SIM_SCENARIO=semiconductors
# SIM_AWAKEN_SECONDS=60
# SIM_BREAKOUT_SECONDS=200
# SIM_TICK_RATE_HZ=4
# SIM_SEED=1337
