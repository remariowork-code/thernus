<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the market worker.

  Keeps the worker running and restarts it if it exits — which it does
  deliberately when its reconnect budget is exhausted, so that a clean restart
  re-establishes the provider connection.

  Install:
    cp scripts/com.marketpulse.worker.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.marketpulse.worker.plist

  Stop:
    launchctl unload ~/Library/LaunchAgents/com.marketpulse.worker.plist

  Replace REPLACE_WITH_PROJECT_PATH with the absolute path to this repo.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.marketpulse.worker</string>

  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_PROJECT_PATH/scripts/run-worker.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_PROJECT_PATH</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart on exit; the worker exits non-zero when it gives up reconnecting. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Do not hot-loop if it fails immediately. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>REPLACE_WITH_PROJECT_PATH/worker.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_PROJECT_PATH/worker.error.log</string>
</dict>
</plist>
