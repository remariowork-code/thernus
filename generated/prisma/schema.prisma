// MarketPulse durable store.
//
// Postgres holds only what must outlive a process: the configurable universe,
// discrete signals, alert history and news. Everything that changes tick by
// tick lives in Redis — writing metrics here would put thousands of rows a
// second in front of a disk for no benefit.

// Prisma 7: the connection URL lives in prisma.config.ts for migrations, and
// reaches the client through a driver adapter (see src/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?
  watchlists  Watchlist[]
  alertRules  AlertRule[]
  alertEvents AlertEvent[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Watchlist {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  symbols   WatchlistSymbol[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model WatchlistSymbol {
  id          String    @id @default(uuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol      String
  createdAt   DateTime  @default(now())

  @@unique([watchlistId, symbol])
  @@index([symbol])
}

model Sector {
  id          String        @id @default(uuid())
  // Stable human-readable key ("semiconductors") used in Redis keys and URLs,
  // so a rename of `name` never breaks a bookmark or a cached key.
  slug        String        @unique
  name        String        @unique
  description String?
  active      Boolean       @default(true)
  stocks      SectorStock[]
  signals     Signal[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([active])
}

model Stock {
  id        String        @id @default(uuid())
  symbol    String        @unique
  name      String
  exchange  String
  active    Boolean       @default(true)
  sectors   SectorStock[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([active])
}

model SectorStock {
  id       String @id @default(uuid())
  sectorId String
  stockId  String
  // Relative influence on the sector score. 1.0 is equal-weight.
  weight   Float  @default(1.0)
  sector   Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  stock    Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([sectorId, stockId])
  @@index([stockId])
}

enum SignalType {
  MOMENTUM_START
  MOMENTUM_ACCELERATION
  VOLUME_SPIKE
  NEW_HIGH
  VWAP_BREAK
  SECTOR_AWAKENING
  SECTOR_BREAKOUT
  SECTOR_ACCELERATION
  CATALYST
}

enum SignalSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Signal {
  id            String         @id
  symbol        String?
  sectorId      String?
  sector        Sector?        @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  type          SignalType
  severity      SignalSeverity
  score         Float
  triggerValue  Float
  previousValue Float?
  // The rendered human sentence, stored so history reads the same as it did live.
  headline      String
  metadata      Json
  alertEvents   AlertEvent[]
  outcome       SignalOutcome?
  createdAt     DateTime       @default(now())

  @@index([createdAt])
  @@index([symbol, createdAt])
  @@index([sectorId, createdAt])
  @@index([type, createdAt])
  @@index([severity, createdAt])
}

/// Signal-performance analysis (spec section 29). Populated by a scheduled job
/// that revisits each signal at fixed horizons and records what happened next,
/// so the system can eventually say which signals are worth acting on.
model SignalOutcome {
  id              String    @id @default(uuid())
  signalId        String    @unique
  signal          Signal    @relation(fields: [signalId], references: [id], onDelete: Cascade)
  priceAtSignal   Float
  return5m        Float?
  return15m       Float?
  return30m       Float?
  return60m       Float?
  // Maximum favourable / adverse excursion within the 60-minute window.
  maxFavorable    Float?
  maxAdverse      Float?
  continuedHigher Boolean?
  evaluatedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([evaluatedAt])
}

model AlertRule {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        SignalType?
  sectorId    String?
  // Minimum severity that will surface for this rule.
  minSeverity SignalSeverity @default(LOW)
  threshold   Float          @default(0)
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, enabled])
}

model AlertEvent {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId    String
  signal      Signal    @relation(fields: [signalId], references: [id], onDelete: Cascade)
  delivered   Boolean   @default(false)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, signalId])
  @@index([userId, createdAt])
}

model NewsArticle {
  id           String       @id @default(uuid())
  headline     String
  source       String
  url          String       @unique
  publishedAt  DateTime
  catalystType String
  symbols      NewsSymbol[]
  createdAt    DateTime     @default(now())

  @@index([publishedAt])
}

model NewsSymbol {
  id            String      @id @default(uuid())
  newsArticleId String
  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  symbol        String
  sectorId      String?

  @@unique([newsArticleId, symbol])
  @@index([symbol])
}
